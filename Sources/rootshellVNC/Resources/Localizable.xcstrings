    "Lossless framebuffer updates with higher bandwidth and CPU use." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحديثات بلا فقدان للمخزن المؤقت للإطارات مع استخدام أعلى للنطاق الترددي والمعالج."
          }
        },
        "ca" : {
          "stringUnit" : {
