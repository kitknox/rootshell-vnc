    "The password will be typed into the remote computer, followed by Return." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُكتب كلمة السر في الكمبيوتر البعيد، متبوعةً بمفتاح Return."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contrasenya s'escriurà a l'ordinador remot, seguida de la tecla Retorn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heslo bude napsáno do vzdáleného počítače a potvrzeno klávesou Return."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgangskoden bliver skrevet på den eksterne computer efterfulgt af Retur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort wird auf dem entfernten Computer eingegeben, gefolgt von der Return-Taste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se escribirá en el ordenador remoto, seguida de Retorno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salasana kirjoitetaan etätietokoneelle ja sen perään painetaan Return-näppäintä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe sera saisi sur l’ordinateur distant, suivi de la touche Retour."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסיסמה תוקלד במחשב המרוחק, ולאחריה Return."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rendszer beírja a jelszót a távoli számítógépbe, majd megnyomja a Return billentyűt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password verrà digitata sul computer remoto, seguita da Invio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードがリモートコンピュータに入力され、続いてReturnキーが押されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호가 원격 컴퓨터에 입력된 다음 Return 키가 입력됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passordet skrives inn på den eksterne maskinen, etterfulgt av Retur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wachtwoord wordt op de externe computer getypt, gevolgd door Return."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasło zostanie wpisane na zdalnym komputerze, a następnie zostanie naciśnięty klawisz Return."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A senha será digitada no computador remoto, seguida de Return."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A palavra-passe será escrita no computador remoto, seguida de Return."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parola va fi tastată pe computerul la distanță, urmată de Return."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geslo bo vtipkano v oddaljeni računalnik, sledila bo tipka Return."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösenordet skrivs in på fjärrdatorn, följt av returtangenten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароль буде введено на віддаленому комп’ютері, після чого натиснуто Return."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu sẽ được gõ vào máy tính từ xa, theo sau là phím Return."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码将输入到远程电脑，随后按下 Return 键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼將輸入至遠端電腦，然後按下 Return 鍵。"
          }
        }
      }
    },
    "The remote computer did not confirm the change, so its display may still be visible to anyone nearby." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يؤكد الكمبيوتر البعيد التغيير، لذا قد تظل شاشته مرئية لأي شخص قريب منه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinador remot no ha confirmat el canvi, de manera que la seva pantalla encara pot ser visible per a qualsevol persona propera."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzdálený počítač změnu nepotvrdil, takže jeho displej může být stále viditelný pro kohokoli v okolí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den eksterne computer bekræftede ikke ændringen, så dens skærm kan stadig være synlig for alle i nærheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der entfernte Computer hat die Änderung nicht bestätigt. Sein Display ist möglicherweise weiterhin für Personen in der Nähe sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ordenador remoto no ha confirmado el cambio, por lo que su pantalla aún podría ser visible para cualquier persona que esté cerca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etätietokone ei vahvistanut muutosta, joten sen näyttö voi yhä näkyä lähellä oleville."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ordinateur distant n’a pas confirmé le changement : son écran peut donc rester visible par toute personne se trouvant à proximité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחשב המרוחק לא אישר את השינוי, ולכן ייתכן שהתצוגה שלו עדיין גלויה לכל מי שנמצא בקרבתו."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A távoli számítógép nem erősítette meg a módosítást, így a kijelzője továbbra is látható lehet a közelben tartózkodók számára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il computer remoto non ha confermato la modifica, quindi il suo schermo potrebbe essere ancora visibile a chiunque si trovi nelle vicinanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートコンピュータから変更の確認が返されなかったため、そのディスプレイが近くにいる人に見えたままになっている可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 컴퓨터가 변경 사항을 확인해 주지 않았으므로 해당 디스플레이가 여전히 주변 사람들에게 보일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den eksterne maskinen bekreftet ikke endringen, så skjermen kan fremdeles være synlig for alle i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De externe computer heeft de wijziging niet bevestigd, dus het scherm is mogelijk nog steeds zichtbaar voor iedereen in de buurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdalny komputer nie potwierdził zmiany, więc jego ekran może być nadal widoczny dla osób znajdujących się w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador remoto não confirmou a alteração, então a tela dele ainda pode estar visível para quem estiver por perto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O computador remoto não confirmou a alteração, pelo que o respetivo ecrã pode continuar visível para quem estiver por perto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computerul la distanță nu a confirmat schimbarea, așa că ecranul acestuia poate fi în continuare vizibil pentru oricine se află în apropiere."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddaljeni računalnik ni potrdil spremembe, zato je njegov zaslon morda še vedno viden vsem v bližini."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjärrdatorn bekräftade inte ändringen, så dess skärm kan fortfarande vara synlig för alla i närheten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Віддалений комп’ютер не підтвердив зміну, тому його дисплей може бути й досі видимий для тих, хто поруч."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy tính từ xa chưa xác nhận thay đổi, vì vậy màn hình của máy đó có thể vẫn hiển thị với bất kỳ ai ở gần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程电脑未确认此更改，其显示器可能仍对附近的人可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "遠端電腦未確認此變更，其顯示器可能仍會被附近的人看見。"
          }
        }
      }
    },
    "The remote computer's own display will be hidden while you keep control. Anyone at that computer sees a lock screen with your message." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُخفى شاشة الكمبيوتر البعيد نفسه طوال فترة تحكمك فيه. وسيرى أي شخص أمام ذلك الكمبيوتر شاشة قفل تتضمن رسالتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de l’ordinador remot es mantindrà oculta mentre en tinguis el control. Qualsevol persona que hi hagi al davant veurà una pantalla bloquejada amb el teu missatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Displej vzdáleného počítače bude po celou dobu, kdy jej ovládáte, skrytý. Kdokoli u tohoto počítače uvidí zamčenou obrazovku s vaší zprávou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærmen på den eksterne computer bliver skjult, så længe du har kontrollen. Alle, der sidder ved den computer, ser en låst skærm med din besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Display des entfernten Computers bleibt ausgeblendet, solange du ihn steuerst. Wer sich an diesem Computer befindet, sieht einen Sperrbildschirm mit deiner Mitteilung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla del ordenador remoto permanecerá oculta mientras lo controles. Cualquier persona que esté ante ese ordenador verá una pantalla de bloqueo con tu mensaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etätietokoneen oma näyttö piilotetaan niin kauan kuin hallitset sitä. Kuka tahansa kyseisen tietokoneen äärellä näkee lukitun näytön ja viestisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran de l’ordinateur distant restera masqué tant que vous le contrôlerez. Toute personne se trouvant devant cet ordinateur verra un écran verrouillé accompagné de votre message."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התצוגה של המחשב המרוחק תוסתר כל עוד השליטה בידיך. כל מי שנמצא ליד אותו מחשב יראה מסך נעילה עם ההודעה שלך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A távoli számítógép saját kijelzője rejtve marad, amíg Ön vezérli. A számítógépnél tartózkodók egy zárolt képernyőt látnak az Ön üzenetével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo schermo del computer remoto resterà nascosto finché mantieni il controllo. Chiunque si trovi davanti a quel computer vedrà una schermata di blocco con il tuo messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートコンピュータを制御している間、そのコンピュータのディスプレイは非表示になります。そのコンピュータの前にいる人には、あなたのメッセージが表示されたロック画面だけが見えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어하는 동안 원격 컴퓨터의 디스플레이는 가려집니다. 해당 컴퓨터 앞에 있는 사람에게는 사용자의 메시지가 표시된 잠금 화면만 보입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjermen til den eksterne maskinen skjules så lenge du styrer den. Alle som sitter ved den maskinen, ser en låst skjerm med meldingen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het scherm van de externe computer blijft verborgen zolang jij de besturing hebt. Iedereen bij die computer ziet een vergrendeld scherm met jouw bericht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran zdalnego komputera pozostanie ukryty, dopóki masz nad nim kontrolę. Każdy, kto znajduje się przy tym komputerze, zobaczy ekran blokady z Twoją wiadomością."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela do computador remoto ficará oculta enquanto você mantiver o controle. Quem estiver naquele computador verá uma tela bloqueada com a sua mensagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ecrã do computador remoto fica oculto enquanto tiver o controlo. Quem estiver nesse computador vê um ecrã bloqueado com a sua mensagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecranul computerului la distanță va fi ascuns cât timp îl controlați. Oricine se află la acel computer vede un ecran blocat cu mesajul dvs."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaslon oddaljenega računalnika bo skrit, dokler ga upravljate. Kdor koli za tem računalnikom bo videl zaklenjen zaslon z vašim sporočilom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjärrdatorns egen skärm döljs så länge du har kontrollen. Alla som sitter vid den datorn ser en låst skärm med ditt meddelande."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплей віддаленого комп’ютера буде приховано, доки ви ним керуєте. Кожен, хто перебуває біля того комп’ютера, побачить екран блокування з вашим повідомленням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Màn hình của máy tính từ xa sẽ bị ẩn trong khi bạn còn điều khiển. Bất kỳ ai ở máy tính đó chỉ nhìn thấy màn hình khóa kèm thông báo của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你控制期间，远程电脑自身的显示器会被隐藏。在那台电脑前的人只会看到显示你信息的锁定屏幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你控制期間，遠端電腦本身的顯示器會隱藏。在那台電腦前的人只會看到顯示你訊息的鎖定畫面。"
          }
        }
      }
    },
    "The remote video stream could not start after %lld attempts. Try again, or switch this connection to Standard mode." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر بدء بث الفيديو البعيد بعد %lld محاولات. حاول مرة أخرى، أو بدّل هذا الاتصال إلى الوضع القياسي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut iniciar el flux de vídeo remot després de %lld intents. Torna-ho a provar o canvia aquesta connexió al mode Estàndard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzdálený video stream se po %lld pokusech nepodařilo spustit. Zkuste to znovu, nebo přepněte toto připojení do standardního režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den eksterne videostrøm kunne ikke starte efter %lld forsøg. Prøv igen, eller skift denne forbindelse til standardtilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der entfernte Videostream konnte nach %lld Versuchen nicht gestartet werden. Erneut versuchen oder diese Verbindung auf den Modus „Standard“ umstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido iniciar el flujo de vídeo remoto tras %lld intentos. Inténtalo de nuevo o cambia esta conexión al modo Estándar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etävideovirtaa ei saatu käynnistettyä %lld yrityksen jälkeen. Yritä uudelleen tai vaihda tämä yhteys Vakio-tilaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le flux vidéo distant n’a pas pu démarrer après %lld tentatives. Réessayez ou basculez cette connexion en mode Standard."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להתחיל את זרם הווידאו המרוחק לאחר %lld ניסיונות. יש לנסות שוב או להעביר את החיבור הזה למצב רגיל."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A távoli videostream %lld próbálkozás után sem indult el. Próbálja újra, vagy váltsa át ezt a kapcsolatot Normál módba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile avviare il flusso video remoto dopo %lld tentativi. Riprova oppure passa questa connessione alla modalità Standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld回試行しましたが、リモートのビデオストリームを開始できませんでした。やり直すか、この接続を標準モードに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번 시도 후에도 원격 비디오 스트림을 시작하지 못했습니다. 다시 시도하거나 이 연결을 표준 모드로 전환하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den eksterne videostrømmen kunne ikke starte etter %lld forsøk. Prøv på nytt, eller bytt denne tilkoblingen til standardmodus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De externe videostream kon na %lld pogingen niet worden gestart. Probeer het opnieuw of schakel deze verbinding over naar de modus ‘Standaard’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się uruchomić zdalnego strumienia wideo po %lld próbach. Spróbuj ponownie lub przełącz to połączenie na tryb Standard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o fluxo de vídeo remoto após %lld tentativas. Tente novamente ou mude esta conexão para o modo Padrão."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível iniciar o fluxo de vídeo remoto após %lld tentativas. Tente novamente ou mude esta ligação para o modo Padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fluxul video la distanță nu a putut porni după %lld încercări. Încercați din nou sau comutați această conexiune la modul Standard."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddaljenega videotoka po %lld poskusih ni bilo mogoče zagnati. Poskusite znova ali preklopite to povezavo v standardni način."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att starta fjärrvideoströmmen efter %lld försök. Försök igen eller växla den här anslutningen till läget Standard."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося запустити віддалений відеопотік після %lld спроб. Спробуйте ще раз або перемкніть це підключення на стандартний режим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể bắt đầu luồng video từ xa sau %lld lần thử. Hãy thử lại hoặc chuyển kết nối này sang chế độ Tiêu chuẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试 %lld 次后仍无法启动远程视频流。请重试，或将此连接切换为标准模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘗試 %lld 次後仍無法啟動遠端影像串流。請再試一次，或將此連線切換為「標準」模式。"
          }
        }
      }
    },
