    "Reliable compressed RFB over TCP for constrained networks, VPNs, and non-Mac servers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بروتوكول RFB مضغوط وموثوق عبر TCP للشبكات المحدودة وشبكات VPN والخوادم غير التابعة لـ Mac."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RFB comprimit i fiable a través de TCP per a xarxes limitades, VPN i servidors que no són Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
