    "Show the remote Mac's physical displays in one combined desktop, matching Apple Screen Sharing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إظهار الشاشات الفعلية لجهاز Mac البعيد في سطح مكتب مدمج واحد، مطابقةً لمشاركة الشاشة من Apple."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra les pantalles físiques del Mac remot en un escriptori combinat, igual que Compartir pantalla d'Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrazit fyzické displeje vzdáleného Macu v jedné sloučené ploše, stejně jako Sdílení obrazovky Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis den eksterne Macs fysiske skærme på ét kombineret skrivebord ligesom Apples Skærmdeling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die physischen Displays des entfernten Mac in einem kombinierten Schreibtisch anzeigen – wie bei „Bildschirmfreigabe“ von Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las pantallas físicas del Mac remoto en un escritorio combinado, igual que «Compartir pantalla» de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä etä-Macin fyysiset näytöt yhtenä yhdistettynä työpöytänä Applen näytön jakamisen tapaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher les écrans physiques du Mac distant sur un seul bureau combiné, comme le Partage d’écran d’Apple."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת הצגים הפיזיים של ה-Mac המרוחק בשולחן עבודה משולב אחד, בדומה ל״שיתוף מסך״ של Apple."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A távoli Mac fizikai kijelzőinek megjelenítése egyetlen egyesített asztalon, az Apple Képernyőmegosztásához hasonlóan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra gli schermi fisici del Mac remoto in un’unica scrivania combinata, come Condivisione schermo di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートMacの物理ディスプレイを1つの結合されたデスクトップに表示します。Appleの画面共有と同じ動作です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 화면 공유와 동일하게 원격 Mac의 물리적 디스플레이를 하나의 통합된 데스크탑에 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis de fysiske skjermene på den eksterne Macen som ett kombinert skrivebord, slik som Apple Skjermdeling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon de fysieke beeldschermen van de externe Mac op één gecombineerd bureaublad, net als Apple Schermdeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj fizyczne ekrany zdalnego Maca jako jedno połączone biurko, tak jak Udostępnianie ekranu Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as telas físicas do Mac remoto em uma área de trabalho combinada, como no Compartilhamento de Tela da Apple."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar os ecrãs físicos do Mac remoto num único ambiente de trabalho combinado, tal como na Partilha de Ecrã da Apple."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează ecranele fizice ale Mac-ului la distanță într-un singur desktop combinat, la fel ca Partajare ecran de la Apple."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži fizične zaslone oddaljenega Maca v enem združenem namizju, tako kot Apple Screen Sharing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa fjärr-Macens fysiska skärmar i ett kombinerat skrivbord, som i Apples Skärmdelning."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показувати фізичні дисплеї віддаленого Mac як один об’єднаний робочий стіл, як у функції «Спільний доступ до екрана» Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị các màn hình vật lý của máy Mac từ xa trong một màn hình nền kết hợp, giống Chia sẻ màn hình của Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将远程 Mac 的实体显示器合并显示为一个桌面，与 Apple“屏幕共享”一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將遠端 Mac 的實體顯示器顯示為一個合併的桌面，與 Apple「螢幕共享」相同。"
          }
        }
      }
    },
