    "High Performance mode requires a direct network connection and is unavailable over a tunneled transport." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب وضع الأداء العالي اتصال شبكة مباشرًا، وهو غير متوفر عبر النقل النفقي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mode d'alt rendiment requereix una connexió de xarxa directa i no està disponible a través d'un transport amb túnel."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim Vysoký výkon vyžaduje přímé síťové připojení a není dostupný přes tunelovaný přenos."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilstanden Høj ydeevne kræver en direkte netværksforbindelse og er ikke tilgængelig via en tunnelleret transport."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Modus „Hohe Leistung“ erfordert eine direkte Netzwerkverbindung und ist über einen getunnelten Transport nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Alto rendimiento requiere una conexión de red directa y no está disponible a través de un transporte por túnel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuri suorituskyky -tila vaatii suoran verkkoyhteyden eikä ole käytettävissä tunneloidussa yhteydessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Hautes performances nécessite une connexion réseau directe et n’est pas disponible via un transport tunnelisé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מצב ביצועים גבוהים מחייב חיבור רשת ישיר ואינו זמין דרך תעבורה מנהררת."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Nagy teljesítmény mód közvetlen hálózati kapcsolatot igényel, és alagutazott átvitelen nem érhető el."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Prestazioni elevate richiede una connessione di rete diretta e non è disponibile su un trasporto in tunnel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高パフォーマンスモードには直接のネットワーク接続が必要なため、トンネル経由のトランスポートでは使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고성능 모드는 직접 네트워크 연결이 필요하며 터널링된 전송에서는 사용할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høy ytelse krever en direkte nettverkstilkobling og er ikke tilgjengelig over en tunnelert forbindelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De modus ‘Hoge prestaties’ vereist een directe netwerkverbinding en is niet beschikbaar via een getunneld transport."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb Wysoka wydajność wymaga bezpośredniego połączenia sieciowego i jest niedostępny przez transport tunelowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Alto Desempenho requer uma conexão de rede direta e não está disponível em um transporte com túnel."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Alto desempenho requer uma ligação de rede direta e não está disponível através de um transporte em túnel."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul Performanță ridicată necesită o conexiune directă la rețea și nu este disponibil printr-un transport tunelat."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Način Visoka zmogljivost zahteva neposredno omrežno povezavo in ni na voljo prek tuneliranega prenosa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läget Hög prestanda kräver en direkt nätverksanslutning och är inte tillgängligt via en tunnlad transport."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим «Висока продуктивність» потребує прямого мережевого з’єднання й недоступний через тунельований транспорт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ Hiệu năng cao yêu cầu kết nối mạng trực tiếp và không khả dụng qua truyền tải đường hầm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高性能模式需要直接的网络连接，无法通过隧道传输使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「高效能」模式需要直接的網路連線，無法透過通道傳輸使用。"
          }
        }
      }
    },
