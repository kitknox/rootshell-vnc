          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volba Podle klienta zatím vytváří jeden virtuální displej o velikosti klienta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas til klient opretter i øjeblikket én virtuel skærm i klientens størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„An Client anpassen“ erstellt derzeit ein virtuelles Display in Clientgröße."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualmente, «Ajustar al cliente» crea una pantalla virtual del tamaño del cliente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovita asiakkaaseen luo tällä hetkellä yhden asiakkaan kokoisen virtuaalinäytön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Adapter au client » crée actuellement un écran virtuel à la taille du client."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה ללקוח יוצרת כרגע צג וירטואלי אחד בגודל הלקוח."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Igazítás a klienshez jelenleg egy kliensméretű virtuális kijelzőt hoz létre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento «Adatta al client» crea un solo schermo virtuale delle dimensioni del client."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「クライアントに合わせる」では現在、クライアントサイズの仮想ディスプレイを1つ作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 ‘클라이언트에 맞춤’은 클라이언트 크기의 가상 디스플레이 하나를 생성합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpass til klient oppretter foreløpig én virtuell skjerm i klientstørrelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Pas aan client aan’ maakt momenteel één virtueel beeldscherm op clientformaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasuj do klienta tworzy obecnie jeden wirtualny ekran w rozmiarze klienta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No momento, Igualar ao Cliente cria uma tela virtual no tamanho do cliente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualmente, o modo Ajustar ao cliente cria um ecrã virtual do tamanho do cliente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Momentan, Potrivire cu clientul creează un singur ecran virtual de dimensiunea clientului."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Možnost Prilagodi odjemalcu trenutno ustvari en navidezni zaslon v velikosti odjemalca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matcha klienten skapar för närvarande en virtuell skärm i klientstorlek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наразі «Як у клієнта» створює один віртуальний дисплей розміром із клієнт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khớp máy khách hiện tạo một màn hình ảo có kích thước máy khách."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“匹配客户端”目前会创建一台客户端尺寸的虚拟显示器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「符合用戶端」目前會建立一個用戶端尺寸的虛擬顯示器。"
          }
        }
      }
    },
    "Match this window or iPad aspect ratio. Supported Macs use a separate virtual display; other VNC servers resize only when they advertise support." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطابقة نسبة العرض إلى الارتفاع لهذه النافذة أو iPad. تستخدم أجهزة Mac المدعومة شاشة افتراضية منفصلة؛ أما خوادم VNC الأخرى فتغيّر الحجم فقط عند إعلانها دعم ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la relació d'aspecte d'aquesta finestra o de l'iPad. Els Mac compatibles fan servir una pantalla virtual independent; els altres servidors VNC només canvien la mida si n'indiquen la compatibilitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přizpůsobí se poměru stran tohoto okna nebo iPadu. Podporované Macy použijí samostatný virtuální displej; ostatní VNC servery změní velikost jen tehdy, když to oznámí jako podporované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpas til dette vindues eller denne iPads højde-breddeforhold. Understøttede Mac-computere bruger en separat virtuel skærm; andre VNC-servere ændrer kun størrelse, når de angiver understøttelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An das Seitenverhältnis dieses Fensters oder iPads anpassen. Unterstützte Macs verwenden ein separates virtuelles Display; andere VNC-Server passen die Größe nur an, wenn sie dies unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la proporción de esta ventana o del iPad. Los Mac compatibles usan una pantalla virtual aparte; otros servidores VNC solo cambian el tamaño si indican que lo admiten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovita tämän ikkunan tai iPadin kuvasuhteeseen. Tuetut Macit käyttävät erillistä virtuaalinäyttöä; muut VNC-palvelimet muuttavat kokoa vain, jos ne ilmoittavat tukevansa sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapter au format de cette fenêtre ou de cet iPad. Les Mac compatibles utilisent un écran virtuel distinct ; les autres serveurs VNC ne se redimensionnent que s’ils annoncent la prise en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התאמה ליחס הגובה-רוחב של חלון זה או של ה-iPad. מחשבי Mac נתמכים משתמשים בצג וירטואלי נפרד; שרתי VNC אחרים משנים גודל רק אם הם מכריזים על תמיכה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Igazodás ennek az ablaknak vagy iPadnek a képarányához. A támogatott Mac gépek külön virtuális kijelzőt használnak; más VNC-szerverek csak akkor méreteznek át, ha jelzik ennek támogatását."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adatta le proporzioni a questa finestra o all’iPad. I Mac supportati usano uno schermo virtuale separato; gli altri server VNC si ridimensionano solo se ne dichiarano il supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウまたはiPadの縦横比に合わせます。対応するMacは個別の仮想ディスプレイを使用します。ほかのVNCサーバは、サポートを通知している場合のみサイズを変更します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 윈도우 또는 iPad의 종횡비에 맞춥니다. 지원되는 Mac은 별도의 가상 디스플레이를 사용하며, 다른 VNC 서버는 지원을 알리는 경우에만 크기를 조절합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilpass til størrelsesforholdet til dette vinduet eller denne iPaden. Macer med støtte bruker en egen virtuell skjerm; andre VNC-servere endrer størrelse bare hvis de oppgir at de støtter det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de beeldverhouding van dit venster of deze iPad. Ondersteunde Macs gebruiken een apart virtueel beeldscherm; andere VNC-servers passen het formaat alleen aan als ze aangeven dit te ondersteunen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasuj do proporcji tego okna lub iPada. Obsługiwane Maki używają osobnego wirtualnego ekranu; inne serwery VNC zmieniają rozmiar tylko wtedy, gdy zgłaszają obsługę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iguala a proporção desta janela ou do iPad. Macs compatíveis usam uma tela virtual separada; outros servidores VNC só redimensionam quando anunciam suporte."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corresponder à proporção desta janela ou do iPad. Os Mac compatíveis usam um ecrã virtual separado; os outros servidores VNC só redimensionam se anunciarem suporte."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrivește raportul de aspect al acestei ferestre sau al iPad-ului. Mac-urile compatibile folosesc un ecran virtual separat; celelalte servere VNC redimensionează doar dacă anunță că acceptă acest lucru."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilagodi razmerju stranic tega okna ali iPada. Podprti Maci uporabijo ločen navidezni zaslon; drugi strežniki VNC spremenijo velikost le, če to podporo oglašujejo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matcha det här fönstrets eller din iPads bildförhållande. Mac-datorer med stöd använder en separat virtuell skärm, andra VNC-servrar ändrar storlek bara när de anger att de har stöd för det."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відповідати співвідношенню сторін цього вікна або iPad. Підтримувані Mac використовують окремий віртуальний дисплей; інші сервери VNC змінюють розмір, лише якщо повідомляють про підтримку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khớp tỷ lệ khung hình của cửa sổ này hoặc iPad. Các máy Mac được hỗ trợ dùng một màn hình ảo riêng; các máy chủ VNC khác chỉ đổi kích thước khi chúng thông báo có hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匹配此窗口或 iPad 的宽高比。支持的 Mac 会使用单独的虚拟显示器；其他 VNC 服务器仅在声明支持时才会调整大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "符合此視窗或 iPad 的長寬比。支援的 Mac 會使用個別的虛擬顯示器；其他 VNC 伺服器僅在表明支援時才會調整大小。"
          }
        }
      }
    },
