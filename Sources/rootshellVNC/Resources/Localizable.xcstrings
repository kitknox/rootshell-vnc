    "Couldn’t reconnect after %lld attempts. Check the network or server, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة الاتصال بعد %lld محاولات. تحقق من الشبكة أو الخادم، ثم حاول مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut tornar a connectar després de %lld intents. Comprova la xarxa o el servidor i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po %lld pokusech se nepodařilo znovu připojit. Zkontrolujte síť nebo server a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke oprette forbindelse igen efter %lld forsøg. Kontroller netværket eller serveren, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung konnte nach %lld Versuchen nicht wiederhergestellt werden. Netzwerk oder Server prüfen und erneut versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido volver a conectar tras %lld intentos. Comprueba la red o el servidor e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleenyhdistäminen ei onnistunut %lld yrityksen jälkeen. Tarkista verkko tai palvelin ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnexion impossible après %lld tentatives. Vérifiez le réseau ou le serveur, puis réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה להתחבר מחדש לאחר %lld ניסיונות. יש לבדוק את הרשת או את השרת ולנסות שוב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült újracsatlakozni %lld próbálkozás után. Ellenőrizze a hálózatot vagy a szervert, majd próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconnessione non riuscita dopo %lld tentativi. Controlla la rete o il server, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld回試行しましたが、再接続できませんでした。ネットワークまたはサーバを確認してから、やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld번 시도 후 재연결하지 못했습니다. 네트워크 또는 서버를 확인한 다음 다시 시도하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke koble til igjen etter %lld forsøk. Kontroller nettverket eller serveren, og prøv på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnieuw verbinden is na %lld pogingen niet gelukt. Controleer het netwerk of de server en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć ponownie po %lld próbach. Sprawdź sieć lub serwer, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível reconectar após %lld tentativas. Verifique a rede ou o servidor e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível restabelecer a ligação após %lld tentativas. Verifique a rede ou o servidor e tente novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconectarea nu a reușit după %lld încercări. Verificați rețeaua sau serverul, apoi încercați din nou."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po %lld poskusih ponovna povezava ni uspela. Preverite omrežje ali strežnik in poskusite znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att återansluta efter %lld försök. Kontrollera nätverket eller servern och försök igen."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перепідключитися після %lld спроб. Перевірте мережу або сервер, а потім спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể kết nối lại sau %lld lần thử. Hãy kiểm tra mạng hoặc máy chủ, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试 %lld 次后仍无法重新连接。请检查网络或服务器，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嘗試 %lld 次後仍無法重新連接。請檢查網路或伺服器，然後再試一次。"
          }
        }
      }
    },
