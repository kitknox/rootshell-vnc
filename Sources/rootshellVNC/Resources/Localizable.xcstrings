    "When an Apple Login Window or lock screen is detected, offer to type the saved password." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند اكتشاف نافذة تسجيل دخول Apple أو شاشة القفل، اعرض كتابة كلمة السر المحفوظة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan es detecti una finestra d’inici de sessió d’Apple o una pantalla de bloqueig, s’ofereix escriure la contrasenya desada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je zjištěno přihlašovací okno Apple nebo zamykací obrazovka, nabídnout napsání uloženého hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et Apple-loginvindue eller en låst skærm registreres, tilbydes det at skrive den arkiverede adgangskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Apple-Anmeldefenster oder ein Sperrbildschirm erkannt wird, wird angeboten, das gesicherte Passwort einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se detecta una ventana de inicio de sesión de Apple o una pantalla de bloqueo, se ofrece escribir la contraseña guardada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Applen kirjautumisikkuna tai lukitusnäyttö havaitaan, tarjotaan tallennetun salasanan kirjoittamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’une fenêtre de connexion Apple ou un écran verrouillé est détecté, propose de saisir le mot de passe enregistré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר מזוהה חלון כניסה של Apple או מסך נעילה, מוצע להקליד את הסיסמה השמורה."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a rendszer Apple bejelentkezési ablakot vagy zárolási képernyőt észlel, felajánlja a mentett jelszó beírását."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando viene rilevata una finestra di login Apple o una schermata di blocco, propone di digitare la password salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのログインウインドウまたはロック画面が検出されたときに、保存されているパスワードの入力を提案します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 로그인 윈도우 또는 잠금 화면이 감지되면 저장된 암호 입력을 제안합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når et Apple-påloggingsvindu eller en låst skjerm oppdages, tilbys det å skrive inn det arkiverte passordet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer een Apple-inlogvenster of een vergrendeld scherm wordt gedetecteerd, wordt aangeboden om het bewaarde wachtwoord te typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zostanie wykryte okno logowania Apple lub ekran blokady, zaproponuj wpisanie zachowanego hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma janela de login da Apple ou uma tela bloqueada for detectada, oferecer para digitar a senha salva."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma janela de início de sessão da Apple ou um ecrã bloqueado for detetado, oferecer escrever a palavra-passe guardada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când este detectată o fereastră de autentificare Apple sau un ecran blocat, se oferă tastarea parolei salvate."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko je zaznano Applovo prijavno okno ali zaklenjen zaslon, ponudi vtipkanje shranjenega gesla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När ett Apple-inloggningsfönster eller en låst skärm upptäcks erbjuds du att skriva in det sparade lösenordet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли виявлено вікно входу Apple або екран блокування, пропонувати ввести збережений пароль."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi phát hiện cửa sổ đăng nhập của Apple hoặc màn hình khóa, đề nghị gõ mật khẩu đã lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当检测到 Apple 登录窗口或锁定屏幕时，提示输入已存储的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當偵測到 Apple 登入視窗或鎖定螢幕時，提示輸入已儲存的密碼。"
          }
        }
      }
    },
