    "Ask a capable Mac for two client-sized virtual displays with independent High Performance video streams." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من جهاز Mac متوافق شاشتين افتراضيتين بحجم العميل مع بثّي فيديو مستقلين بأداء عالٍ."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol·licita a un Mac compatible dues pantalles virtuals de la mida del client, amb fluxos de vídeo d'alt rendiment independents."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžádat si od podporovaného Macu dva virtuální displeje o velikosti klienta s nezávislými video streamy v režimu Vysoký výkon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed en understøttet Mac om to virtuelle skærme i klientens størrelse med uafhængige videostrømme med høj ydeevne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von einem geeigneten Mac zwei virtuelle Displays in Clientgröße mit unabhängigen Videostreams im Modus „Hohe Leistung“ anfordern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita a un Mac compatible dos pantallas virtuales del tamaño del cliente con flujos de vídeo de alto rendimiento independientes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä yhteensopivalta Macilta kahta asiakkaan kokoista virtuaalinäyttöä, joilla on omat Suuri suorituskyky -videovirrat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander à un Mac compatible deux écrans virtuels à la taille du client, avec des flux vidéo Hautes performances indépendants."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בקשה ממחשב Mac נתמך לשני צגים וירטואליים בגודל הלקוח, עם זרמי וידאו נפרדים בביצועים גבוהים."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Két kliensméretű virtuális kijelző kérése egy támogató Mac géptől, önálló, nagy teljesítményű videostreamekkel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi a un Mac compatibile due schermi virtuali delle dimensioni del client, con flussi video Prestazioni elevate indipendenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応するMacに、独立した高パフォーマンスビデオストリームを持つクライアントサイズの仮想ディスプレイを2つ要求します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 Mac에 독립적인 고성능 비디오 스트림을 갖춘 클라이언트 크기의 가상 디스플레이 두 개를 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be en Mac med støtte om to virtuelle skjermer i klientstørrelse med uavhengige videostrømmer i Høy ytelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag een geschikte Mac om twee virtuele beeldschermen op clientformaat met onafhankelijke videostreams met hoge prestaties."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś obsługiwanego Maca o dwa wirtualne ekrany w rozmiarze klienta z niezależnymi strumieniami wideo w trybie Wysoka wydajność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita a um Mac compatível duas telas virtuais no tamanho do cliente, com fluxos de vídeo de Alto Desempenho independentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir a um Mac compatível dois ecrãs virtuais do tamanho do cliente, com fluxos de vídeo Alto desempenho independentes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicită unui Mac compatibil două ecrane virtuale de dimensiunea clientului, cu fluxuri video Performanță ridicată independente."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od podprtega Maca zahtevaj dva navidezna zaslona v velikosti odjemalca z ločenima videotokoma Visoke zmogljivosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be en kompatibel Mac om två virtuella skärmar i klientstorlek med separata videoströmmar med hög prestanda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запитати в сумісного Mac два віртуальні дисплеї розміром із клієнт із незалежними відеопотоками «Висока продуктивність»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu máy Mac được hỗ trợ tạo hai màn hình ảo có kích thước máy khách với các luồng video Hiệu năng cao độc lập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向支持的 Mac 请求两个客户端尺寸的虚拟显示器，各自使用独立的高性能视频流。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向支援的 Mac 要求兩個用戶端尺寸的虛擬顯示器，各有獨立的高效能影像串流。"
          }
        }
      }
    },
